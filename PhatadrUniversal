local cachedChar = localPlayer.Character
local cachedHum = cachedChar and cachedChar:FindFirstChildOfClass("Humanoid")
local cachedRoot = cachedChar and cachedChar:FindFirstChild("HumanoidRootPart")
local cachedParts = {}
local cachedDecals = {}

local function refreshCharCache(char)
    cachedChar = char
    cachedHum = char and char:FindFirstChildOfClass("Humanoid")
    cachedRoot = char and char:FindFirstChild("HumanoidRootPart")
    table.clear(cachedParts)
    table.clear(cachedDecals)
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            table.insert(cachedParts, obj)
        elseif obj:IsA("Decal") then
            table.insert(cachedDecals, obj)
        end
    end
end

if cachedChar then
    refreshCharCache(cachedChar)
end

localPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.2)
    refreshCharCache(char)
end)

local function getCharNow()
    if cachedChar and cachedChar.Parent and cachedHum and cachedHum.Parent and cachedRoot and cachedRoot.Parent then
        return cachedChar, cachedHum, cachedRoot
    end
    local char = localPlayer.Character
    if char then
        refreshCharCache(char)
    end
    return cachedChar, cachedHum, cachedRoot
end

