-- 5. ESP VIỀN ĐỎ NGƯỜI CHƠI
local function applyRedOutlineEsp()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character then
            local hl = activeHighlights[plr]
            if not hl or not hl.Parent then
                hl = Instance.new("Highlight")
                hl.Name = "PhatadrRedOutline"
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.FillColor = Color3.fromRGB(255, 35, 45)
                hl.FillTransparency = 0.85
                hl.OutlineColor = Color3.fromRGB(255, 35, 45)
                hl.OutlineTransparency = 0
                hl.Parent = espFolder
                activeHighlights[plr] = hl
            end
            if hl.Adornee ~= plr.Character then
                hl.Adornee = plr.Character
            end
        end
    end

    for plr, hl in pairs(activeHighlights) do
        if not plr or not plr.Parent or not plr.Character or not plr.Character.Parent then
            pcall(function()
                if hl then hl:Destroy() end
            end)
            activeHighlights[plr] = nil
        end
    end
end

makeToggleRow("ESP Viền Đỏ", 5, function(state)
    espEnabled = state
    if state then
        pcall(applyRedOutlineEsp)
    else
        clearAllEsp()
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    local hl = activeHighlights[plr]
    if hl then
        pcall(function() hl:Destroy() end)
        activeHighlights[plr] = nil
    end
end)

task.spawn(function()
    while true do
        task.wait(0.4)
        if espEnabled and screenGui.Parent then
            pcall(applyRedOutlineEsp)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if walkSpeedActive then
        pcall(function()
            local _, hum = getCharNow()
            if hum and hum.WalkSpeed ~= customWalkSpeed then
                hum.WalkSpeed = customWalkSpeed
            end
        end)
    end
    if invisibleEnabled then
        pcall(applyInvis, true)
    end
    if noclipEnabled then
        pcall(function()
            local _, hum, root = getCharNow()
            if not root then return end

            for _, p in ipairs(cachedParts) do
                if p and p.Parent then
                    if p.Name == "LeftFoot" or p.Name == "RightFoot" or p.Name == "LeftLowerLeg" or p.Name == "RightLowerLeg" then
                        p.CanCollide = true
                    elseif p.CanCollide then
                        p.CanCollide = false
                    end
                end
            end

            local detectedFloor = getGroundYBelow(root.Position)
            if detectedFloor and (not floorLockY or detectedFloor > floorLockY - 2) then
                floorLockY = detectedFloor
            end

            if floorLockY and root.Position.Y < floorLockY then
                local vel = root.AssemblyLinearVelocity
                if vel.Y < 0 then
                    root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                end
                root.CFrame = CFrame.new(root.Position.X, floorLockY, root.Position.Z) * root.CFrame.Rotation
                if hum and hum:GetState() == Enum.HumanoidStateType.Freefall then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end
        end)
    end
end)

