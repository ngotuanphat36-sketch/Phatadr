-- 2. TÀNG HÌNH
local invisibleEnabled = false
local function applyInvis(active)
    for _, part in ipairs(cachedParts) do
        if part and part.Parent and part.Name ~= "HumanoidRootPart" then
            local target = active and 1 or 0
            if part.LocalTransparencyModifier ~= target then
                part.LocalTransparencyModifier = target
            end
        end
    end
    for _, dec in ipairs(cachedDecals) do
        if dec and dec.Parent then
            local target = active and 1 or 0
            if dec.Transparency ~= target then
                dec.Transparency = target
            end
        end
    end
end

makeToggleRow("Tàng Hình", 2, function(state)
    invisibleEnabled = state
    applyInvis(state)
end)

-- 3. XUYÊN TƯỜNG (KHÔNG RƠI XUỐNG LÒNG ĐẤT)
local noclipEnabled = false
local floorLockY = nil

local function getGroundYBelow(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    if cachedChar then
        params.FilterDescendantsInstances = { cachedChar }
    end
    local hit = Workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -35, 0), params)
    if hit then
        return hit.Position.Y + 3.0
    end
    return nil
end

makeToggleRow("Xuyên Tường", 3, function(state)
    noclipEnabled = state
    floorLockY = nil
    if state then
        pcall(function()
            local _, _, root = getCharNow()
            if root then
                floorLockY = getGroundYBelow(root.Position) or root.Position.Y
            end
        end)
    else
        pcall(function()
            for _, p in ipairs(cachedParts) do
                if p and p.Parent then
                    p.CanCollide = true
                end
            end
        end)
    end
end)

